NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key for server-only Supabase clients (e.g. the WhatsApp webhook), bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# The public URL this app is reachable at — Uazapi calls back to this to deliver inbound messages.
NEXT_PUBLIC_APP_URL=
# Cloudflare Turnstile — bot check on the public booking form (/agendar).
# Without both keys the check is skipped in dev and fails closed in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# HMAC secret that signs the public consent-signing link tokens (/assinar).
# Without it, dev uses a fixed fallback and production fails closed (no link
# is accepted). See docs/ops/consent-link-secret.md. Generate: openssl rand -base64 48
CONSENT_LINK_SECRET=
# Secret que protege a rota interna de retenção de mídia do WhatsApp
# (/api/whatsapp/media-retention), chamada pelo Cron Trigger. Sem ela a rota
# responde 401. Gerar: openssl rand -base64 32
MEDIA_RETENTION_SECRET=
